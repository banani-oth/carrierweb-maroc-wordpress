{
  "name": "carrierweb-theme",
  "version": "0.3.2",
  "private": true,
  "description": "Compilation des styles et scripts du thème CarrierWeb Maroc.",
  "scripts": {
    "dev": "tailwindcss -i ./assets/src/app.css -o ./assets/dist/app.css --watch",
    "build:css": "tailwindcss -i ./assets/src/app.css -o ./assets/dist/app.css --minify",
    "build:js": "node ./tools/build-js.mjs",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
